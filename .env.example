# ─────────────────────────────────────────────────────────────────────────
# Katitos environment. Copy to `.env.local` for local dev.
# Client vars MUST be prefixed VITE_ (they are bundled into the browser app).
# Secrets (service role, VAPID private) NEVER go here — see supabase/functions/.env
# ─────────────────────────────────────────────────────────────────────────

# Local Supabase (the CLI prints these on `supabase start`; these are the
# deterministic CLI defaults, identical on every machine).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# 'local' = dev auto-login + user switcher (no login wall).
# 'prod'  = real Supabase Auth login screen.
VITE_AUTH_MODE=local

# Web Push (VAPID) public key. Dev keypair below — regenerate for prod with
# `node scripts/gen-vapid.mjs` and set the private half in supabase/functions/.env.
VITE_VAPID_PUBLIC_KEY=BPjuhuW8QrcQnH9ag6rcIjZRtrDRW7v2PulJI4TT1qS8yE8rEamiv8odjZOJGa1zT_lNoMSSevhXrw4huzDta44

# Seeded local accounts (used only when VITE_AUTH_MODE=local).
VITE_DEV_USER_A_EMAIL=vicente@katitos.local
VITE_DEV_USER_A_PASSWORD=katitos123
VITE_DEV_USER_B_EMAIL=anastasia@katitos.local
VITE_DEV_USER_B_PASSWORD=katitos123
