# Dev-oriented image for the Vite dev server.
# Production on Vercel does NOT use this — Vercel builds the static SPA itself.
FROM node:22-alpine

WORKDIR /app

# Install deps first for layer caching. node_modules lives in an anonymous
# volume (see docker-compose.yml) so it is not clobbered by the source mount.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
